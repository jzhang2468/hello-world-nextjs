# Copy this file to .env.local and fill in your Supabase project values.
# These variables are read only by the server. Never use a service_role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Add to .env.local and, after preview approval, Vercel settings.
# Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_CAPTION_MODEL=gpt-4.1-mini

# Server-only 64-character hex secret authorizing the caption pipeline RPCs.
# Use scripts/setup-caption-pipeline.mjs to generate it and the DB digest SQL.
# Store only the digest in private.caption_generation_credentials.
CAPTION_PIPELINE_SECRET=
